# Credenciales de Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJh...tu_anon_public_key...

# Service Role Key (Solo para scripts administrativos locales como seed.js - NUNCA exponer al front)
SUPABASE_SERVICE_ROLE_KEY=eyJh...tu_service_role_key...

# Cloudflare R2 Storage (R2 Dashboard > Manage R2 API Tokens)
# ⚠️ Claves privadas de R2 (Solo usadas por backend/servidor de subida - NUNCA exponer al cliente)
R2_ACCOUNT_ID=tu_cloudflare_account_id
R2_ACCESS_KEY_ID=tu_r2_access_key_id
R2_SECRET_ACCESS_KEY=tu_r2_secret_access_key
R2_BUCKET_NAME=nombre_de_tu_bucket_r2
R2_PUBLIC_DOMAIN=https://pub-xxxxxxxx.r2.dev
